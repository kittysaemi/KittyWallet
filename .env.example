NODE_ENV=local
API_URL=http://localhost:5173/kittywallet/api/v1
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://kittywallet:kittywallet@localhost:5432/kittywallet?schema=public
JWT_SECRET=change-me-local-only
JWT_REFRESH_SECRET=change-me-local-only
PASSWORD_RESET_URL=http://localhost:5173/kittywallet/reset-password
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@kittywallet.local
PWA_ENABLED=true
CACHE_VERSION=v1
SYNC_BATCH_SIZE=50
SYNC_RETRY_COUNT=3

# 예산 계산기 반복 판별 기준값 (Docs/04_business-policy/예산계산기정책.md 6.3)
BUDGET_RECURRING_OBSERVATION_MONTHS=6
BUDGET_RECURRING_AUTOMATIC_MIN_OCCURRENCES=3
BUDGET_RECURRING_CANDIDATE_MIN_OCCURRENCES=2
BUDGET_RECURRING_INTERVAL_TOLERANCE_PERCENT=20
BUDGET_RECURRING_INTERVAL_TOLERANCE_MIN_DAYS=3
BUDGET_RECURRING_AMOUNT_TOLERANCE_PERCENT=20
BUDGET_CANDIDATE_RECENT_MONTHS=3
